# NeuroTwin Backend Configuration (Cloud-First with Local M4 Fallback)

# ----------------------------------------------------------------------
# 1. PRIMARY CLOUD APIS (1st Priority)
# ----------------------------------------------------------------------
# Groq API Key: Powers both LLM (llama-3.3-70b-versatile, ~0.5s) and STT (whisper-large-v3, ~0.8s)
# Get a free key from: https://console.groq.com
LLM_PROVIDER=groq
STT_PROVIDER=groq
GROQ_API_KEY=

# Qdrant Cloud (Optional - Free cluster from https://cloud.qdrant.io)
# If left blank, falls back to local Qdrant on localhost:6333 or in-memory
QDRANT_URL=
QDRANT_API_KEY=

# Supabase Postgres Mirror (Optional - Cloud relational sync)
SUPABASE_URL=https://jhsgxhotzowzjjoridzy.supabase.co
SUPABASE_SERVICE_KEY=

# ----------------------------------------------------------------------
# 2. LOCAL BACKUP FALLBACKS (Used automatically when offline or no API key)
# ----------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

QDRANT_HOST=localhost
QDRANT_PORT=6333

# Face recognition cosine threshold (reference photos ~0.9+, low-res frames lower)
FACE_MATCH_THRESHOLD=0.50

# Local Whisper model size (cached in models/whisper)
WHISPER_MODEL=base

# ----------------------------------------------------------------------
# 3. SECURITY
# ----------------------------------------------------------------------
# API Key for caregiver endpoints (leave blank to disable auth in dev)
NEUROTWIN_API_KEY=