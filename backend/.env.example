# NeuroTwin backend configuration (copy to backend/.env)

# LLM engine: 'ollama' (default, private) or 'groq' (fast cloud)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
GROQ_API_KEY=

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Face recognition cosine threshold (reference photos ~0.9+, low-res frames lower)
FACE_MATCH_THRESHOLD=0.50

# Whisper model size
WHISPER_MODEL=base

# API Key for caregiver endpoints (leave blank to disable auth in dev)
NEUROTWIN_API_KEY=