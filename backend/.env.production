# NeuroTwin Backend — Production Configuration
# Copy this to backend/.env and customize for your deployment.
#
# Usage:
#   cp .env.production .env
#   # Edit .env with your actual values
#   docker compose up --build

# ─── LLM Configuration ─────────────────────────────────────────
# Provider: "ollama" (local, private) or "groq" (cloud, fast)
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# Groq settings (used when LLM_PROVIDER=groq)
GROQ_API_KEY=

# ─── Qdrant Vector Database ────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ─── Face Recognition ──────────────────────────────────────────
# Cosine similarity threshold for face matching (0.0 - 1.0)
# Reference photos score ~0.9+, low-res frames lower
FACE_MATCH_THRESHOLD=0.50

# ─── Speech Processing ─────────────────────────────────────────
# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=base

# ─── Security ──────────────────────────────────────────────────
# API key for caregiver endpoints (leave blank to disable auth)
# Generate a strong key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NEUROTWIN_API_KEY=

# ─── Visual Context Cache ──────────────────────────────────────
# TTL in seconds for caching the last face/object match
CONTEXT_CACHE_TTL=120

# ─── Logging ───────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
